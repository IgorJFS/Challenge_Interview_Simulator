# ==========================================
# Challenge Interview Simulator Environment Variables
# ==========================================
# Copy this file to '.env' and fill in your actual credentials.
# The '.env' file is gitignored and safe from commits.

# The password to access the interviewer panel dashboard
AUTH_PASSWORD=your_password_here

# Your Google Gemini API Key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
